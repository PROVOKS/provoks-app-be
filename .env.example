# App
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://provoks:provoks@localhost:5432/provoks_lms?schema=public"

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
COOKIE_NAME=provoks_token
COOKIE_SECURE=false

# Domain cookie. Kosongkan untuk development (host-only).
# Di produksi yang FE & API-nya beda subdomain, isi: .domainmu.id
COOKIE_DOMAIN=

# Cloudinary (upload media)
# Kalau CLOUDINARY_API_SECRET diisi → upload signed.
# Kalau kosong → pakai upload preset (harus "unsigned" di dashboard Cloudinary).
CLOUDINARY_CLOUD_NAME=drhn0kkxq
CLOUDINARY_API_KEY=558582336133514
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=provoks_files
CLOUDINARY_FOLDER=provoks
